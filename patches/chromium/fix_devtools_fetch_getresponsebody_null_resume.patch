From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tarun Lalwani <tarunlalwani@gmail.com>
Date: Wed, 29 Jul 2026 14:30:00 +0000
Subject: fix: null Resume / hang on Fetch.getResponseBody then continueResponse

Temporary: guard client_receiver_.Resume() with is_bound(), and
CompleteRequest when continueResponse finds the receiver already unbound
(OnComplete while paused) so the renderer fetch does not hang.

Intended to be removed once https://crbug.com/533493930 /
https://chromium-review.googlesource.com/c/chromium/src/+/8084425 lands
in the Chromium revision Electron rolls.

Share: https://github.com/tarunlalwani/chromium/tree/share/devtools-fetch-getresponsebody-null-resume-patch

---

diff --git a/content/browser/devtools/devtools_url_loader_interceptor.cc b/content/browser/devtools/devtools_url_loader_interceptor.cc
index 36b7104..aad7b277 100644
--- a/content/browser/devtools/devtools_url_loader_interceptor.cc
+++ b/content/browser/devtools/devtools_url_loader_interceptor.cc
@@ -1150,7 +1150,9 @@
   if (!body_reader_) {
     body_reader_ = std::make_unique<BodyReader>(base::BindOnce(
         &InterceptionJob::ResponseBodyComplete, base::Unretained(this)));
-    client_receiver_.Resume();
+    if (client_receiver_.is_bound()) {
+      client_receiver_.Resume();
+    }
   }
   body_reader_->AddCallback(std::move(callback));
   // Needs to happen after |AddCallback| to avoid a DCHECK.
@@ -1171,7 +1173,9 @@
   DCHECK(!!response_metadata_);
   state_ = State::kResponseTaken;
   pending_response_body_pipe_callback_ = std::move(callback);
-  client_receiver_.Resume();
+  if (client_receiver_.is_bound()) {
+    client_receiver_.Resume();
+  }
   if (body_)
     StartLoadingResponseBody(std::move(body_));
 }
@@ -1319,8 +1323,14 @@
     client_->OnReceiveResponse(std::move(response_metadata_->head),
                                std::move(body_),
                                std::move(response_metadata_->cached_metadata));
-    response_metadata_.reset();
-    client_receiver_.Resume();
+    if (client_receiver_.is_bound()) {
+      response_metadata_.reset();
+      client_receiver_.Resume();
+    } else {
+      network::URLLoaderCompletionStatus status = response_metadata_->status;
+      response_metadata_.reset();
+      CompleteRequest(status);
+    }
     return Response::Success();
   }
 
